include LICENSE README.md uv.lock
recursive-include evaluation *.py *.yaml *.sh *.md
include evaluation/resources.json evaluation/mini-source.tar.gz
exclude evaluation/resources.tar.gz
recursive-include tools *.py
recursive-include docs *.md
recursive-include tests *.py
prune evaluation/mini-swe-agent
prune dev
global-exclude __pycache__ *.py[cod] .env .env.*
